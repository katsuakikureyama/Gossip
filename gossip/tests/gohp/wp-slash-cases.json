[
  {"name":"null_passthrough","input_type":"null","input":null,"expected_type":"null","expected":null,"input_after":null},
  {"name":"bool_true_passthrough","input_type":"bool","input":true,"expected_type":"bool","expected":true,"input_after":true},
  {"name":"bool_false_passthrough","input_type":"bool","input":false,"expected_type":"bool","expected":false,"input_after":false},
  {"name":"int_zero_passthrough","input_type":"int","input":0,"expected_type":"int","expected":0,"input_after":0},
  {"name":"int_negative_passthrough","input_type":"int","input":-17,"expected_type":"int","expected":-17,"input_after":-17},
  {"name":"empty_string","input_type":"string","input":"","expected_type":"string","expected":"","input_after":""},
  {"name":"plain_string","input_type":"string","input":"plain text","expected_type":"string","expected":"plain text","input_after":"plain text"},
  {"name":"single_quote","input_type":"string","input":"It's here","expected_type":"string","expected":"It\\'s here","input_after":"It's here"},
  {"name":"double_quote","input_type":"string","input":"say \"hello\"","expected_type":"string","expected":"say \\\"hello\\\"","input_after":"say \"hello\""},
  {"name":"backslash","input_type":"string","input":"left\\right","expected_type":"string","expected":"left\\\\right","input_after":"left\\right"},
  {"name":"nul","input_type":"string","input":"left\u0000right","expected_type":"string","expected":"left\\0right","input_after":"left\u0000right"},
  {"name":"utf8","input_type":"string","input":"猫🦊犬","expected_type":"string","expected":"猫🦊犬","input_after":"猫🦊犬"},
  {"name":"newlines","input_type":"string","input":"first\nsecond\r\nthird","expected_type":"string","expected":"first\nsecond\r\nthird","input_after":"first\nsecond\r\nthird"},
  {"name":"already_escaped","input_type":"string","input":"already\\'escaped","expected_type":"string","expected":"already\\\\\\'escaped","input_after":"already\\'escaped"},
  {"name":"all_special_bytes","input_type":"string","input":"'\"\\\u0000","expected_type":"string","expected":"\\'\\\"\\\\\\0","input_after":"'\"\\\u0000"},
  {"name":"empty_list","input_type":"array","input":[],"expected_type":"array","expected":[],"input_after":[]},
  {"name":"string_list","input_type":"array","input":["a'b","c\\d","e\u0000f"],"expected_type":"array","expected":["a\\'b","c\\\\d","e\\0f"],"input_after":["a'b","c\\d","e\u0000f"]},
  {"name":"mixed_scalars","input_type":"array","input":[null,true,false,4,"a'b"],"expected_type":"array","expected":[null,true,false,4,"a\\'b"],"input_after":[null,true,false,4,"a'b"]},
  {"name":"nested_mixed","input_type":"array","input":[["a'b",false],["c\\d",7],null],"expected_type":"array","expected":[["a\\'b",false],["c\\\\d",7],null],"input_after":[["a'b",false],["c\\d",7],null]},
  {"name":"depth_four","input_type":"array","input":[[[["a\"b"]]]],"expected_type":"array","expected":[[[["a\\\"b"]]]],"input_after":[[[["a\"b"]]]]},
  {"name":"nested_empty_lists","input_type":"array","input":[[],[[],["x'y"]]],"expected_type":"array","expected":[[],[[],["x\\'y"]]],"input_after":[[],[[],["x'y"]]]},
  {"name":"deep_special_mix","input_type":"array","input":["top",[["'\"\\\u0000",-9],"猫"],true],"expected_type":"array","expected":["top",[["\\'\\\"\\\\\\0",-9],"猫"],true],"input_after":["top",[["'\"\\\u0000",-9],"猫"],true]}
